    <bpmn:sequenceFlow id="Flow_r_cskh__r_m3" name="" sourceRef="r_cskh" targetRef="r_m3" />
    <bpmn:sequenceFlow id="Flow_r_m3__r_end" name="" sourceRef="r_m3" targetRef="r_end" />
    <bpmn:association id="Assoc_n_camxuc__r_camxuc" sourceRef="r_camxuc" targetRef="n_camxuc" />
  </bpmn:process>
