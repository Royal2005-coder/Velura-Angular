      <bpmndi:BPMNEdge id="Flow_t_nhan__g_studio_di" bpmnElement="Flow_t_nhan__g_studio"><di:waypoint x="1020.5" y="437.1" /><di:waypoint x="1062.5" y="437.1" /></bpmndi:BPMNEdge>
