<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="Definitions_quan_ly_san_pham" name="Hình 3.12 - Quy trình quản lý sản phẩm" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://velura.vn/bpmn/admin">
  <bpmn:collaboration id="Collaboration_quan_ly_san_pham">
    <bpmn:participant id="Participant_velura" name="Velura" processRef="Process_velura" />
  </bpmn:collaboration>
  <bpmn:process id="Process_velura" isExecutable="false">
    <bpmn:laneSet id="LaneSet_velura">
      <bpmn:lane id="lane_admin" name="Quản trị viên quản lý sản phẩm">
        <bpmn:flowNodeRef>e_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_chon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_nhap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_nhap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_nhap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d_nhap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_nhap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_anh</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_sys" name="Hệ thống">
        <bpmn:flowNodeRef>a_kiem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_luu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_loi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_kiem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_luu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_loi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_kiem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_luu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_loi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d_kiem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d_luu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d_loi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_kiem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_luu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_loi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_hoi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_kho</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_nguong</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_canhbao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_binhthuong</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_log</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ds_log</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="e_start" name="Vào trang Quản lý Sản phẩm"><bpmn:outgoing>Flow_e_start__t_ds</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="t_ds" name="Xem danh sách, lọc và tìm kiếm sản phẩm"><bpmn:incoming>Flow_e_start__t_ds</bpmn:incoming><bpmn:outgoing>Flow_t_ds__g_chon</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g_chon" name="Chọn thao tác?"><bpmn:incoming>Flow_t_ds__g_chon</bpmn:incoming><bpmn:outgoing>Flow_g_chon__a_nhap</bpmn:outgoing><bpmn:outgoing>Flow_g_chon__b_nhap</bpmn:outgoing><bpmn:outgoing>Flow_g_chon__c_nhap</bpmn:outgoing><bpmn:outgoing>Flow_g_chon__d_nhap</bpmn:outgoing><bpmn:outgoing>Flow_g_chon__e_nhap</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="a_nhap" name="Nhập hoặc chỉnh thông tin sản phẩm: tên, SKU, danh mục, mô tả, size, màu, tồn kho"><bpmn:incoming>Flow_g_chon__a_nhap</bpmn:incoming><bpmn:outgoing>Flow_a_nhap__a_anh</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="a_kiem" name="Kiểm tra SKU, giá, danh mục, ảnh và tồn kho"><bpmn:incoming>Flow_a_anh__a_kiem</bpmn:incoming><bpmn:outgoing>Flow_a_kiem__a_gw</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="a_gw" name="Dữ liệu hợp lệ?"><bpmn:incoming>Flow_a_kiem__a_gw</bpmn:incoming><bpmn:outgoing>Flow_a_gw__a_luu</bpmn:outgoing><bpmn:outgoing>Flow_a_gw__a_loi</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="a_luu" name="Lưu sản phẩm, kiểm tra phiên bản bản ghi"><bpmn:incoming>Flow_a_gw__a_luu</bpmn:incoming><bpmn:outgoing>Flow_a_luu__g_hoi</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="a_loi" name="Hủy thao tác"><bpmn:incoming>Flow_a_gw__a_loi</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="b_nhap" name="Chọn sản phẩm, nhập giá gốc, giá bán và lý do đổi giá"><bpmn:incoming>Flow_g_chon__b_nhap</bpmn:incoming><bpmn:outgoing>Flow_b_nhap__b_kiem</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="b_kiem" name="Kiểm tra quyền giá, giá bán không vượt giá gốc, lý do 10–500 ký tự"><bpmn:incoming>Flow_b_nhap__b_kiem</bpmn:incoming><bpmn:outgoing>Flow_b_kiem__b_gw</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="b_gw" name="Giá hợp lệ?"><bpmn:incoming>Flow_b_kiem__b_gw</bpmn:incoming><bpmn:outgoing>Flow_b_gw__b_luu</bpmn:outgoing><bpmn:outgoing>Flow_b_gw__b_loi</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="b_luu" name="Cập nhật giá, ghi lịch sử giá cũ và giá mới"><bpmn:incoming>Flow_b_gw__b_luu</bpmn:incoming><bpmn:outgoing>Flow_b_luu__g_hoi</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="b_loi" name="Hủy đổi giá"><bpmn:incoming>Flow_b_gw__b_loi</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="c_nhap" name="Chọn combo, thêm, sửa số lượng hoặc bỏ sản phẩm thành phần"><bpmn:incoming>Flow_g_chon__c_nhap</bpmn:incoming><bpmn:outgoing>Flow_c_nhap__c_kiem</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="c_kiem" name="Kiểm tra sản phẩm thành phần và số lượng nguyên từ 1"><bpmn:incoming>Flow_c_nhap__c_kiem</bpmn:incoming><bpmn:outgoing>Flow_c_kiem__c_gw</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="c_gw" name="Thành phần hợp lệ?"><bpmn:incoming>Flow_c_kiem__c_gw</bpmn:incoming><bpmn:outgoing>Flow_c_gw__c_luu</bpmn:outgoing><bpmn:outgoing>Flow_c_gw__c_loi</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="c_luu" name="Cập nhật thành phần của combo"><bpmn:incoming>Flow_c_gw__c_luu</bpmn:incoming><bpmn:outgoing>Flow_c_luu__g_hoi</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="c_loi" name="Hủy thao tác"><bpmn:incoming>Flow_c_gw__c_loi</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="d_nhap" name="Chọn sản phẩm, trạng thái mới và lý do thay đổi"><bpmn:incoming>Flow_g_chon__d_nhap</bpmn:incoming><bpmn:outgoing>Flow_d_nhap__d_kiem</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="d_kiem" name="Kiểm tra sản phẩm tồn tại, quyền thao tác và luồng chuyển trạng thái"><bpmn:incoming>Flow_d_nhap__d_kiem</bpmn:incoming><bpmn:outgoing>Flow_d_kiem__d_gw</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="d_gw" name="Thao tác hợp lệ?"><bpmn:incoming>Flow_d_kiem__d_gw</bpmn:incoming><bpmn:outgoing>Flow_d_gw__d_luu</bpmn:outgoing><bpmn:outgoing>Flow_d_gw__d_loi</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="d_luu" name="Cập nhật trạng thái: Đang bán, Tạm ẩn, Hết hàng hoặc Ngừng bán"><bpmn:incoming>Flow_d_gw__d_luu</bpmn:incoming><bpmn:outgoing>Flow_d_luu__g_hoi</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="d_loi" name="Hủy thao tác"><bpmn:incoming>Flow_d_gw__d_loi</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="e_nhap" name="Tải file CSV theo mẫu chuẩn lên hệ thống"><bpmn:incoming>Flow_g_chon__e_nhap</bpmn:incoming><bpmn:outgoing>Flow_e_nhap__e_kiem</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="e_kiem" name="Kiểm tra cả file: cột bắt buộc, SKU, giá, tối đa 500 dòng"><bpmn:incoming>Flow_e_nhap__e_kiem</bpmn:incoming><bpmn:outgoing>Flow_e_kiem__e_gw</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="e_gw" name="File hợp lệ?"><bpmn:incoming>Flow_e_kiem__e_gw</bpmn:incoming><bpmn:outgoing>Flow_e_gw__e_luu</bpmn:outgoing><bpmn:outgoing>Flow_e_gw__e_loi</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="e_luu" name="Thêm mới hoặc cập nhật sản phẩm theo SKU"><bpmn:incoming>Flow_e_gw__e_luu</bpmn:incoming><bpmn:outgoing>Flow_e_luu__g_hoi</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="e_loi" name="Từ chối cả file"><bpmn:incoming>Flow_e_gw__e_loi</bpmn:incoming></bpmn:endEvent>
    <bpmn:callActivity id="a_anh" name="Xử lý ảnh sản phẩm bằng AI (Hình 3.12a)"><bpmn:incoming>Flow_a_nhap__a_anh</bpmn:incoming><bpmn:outgoing>Flow_a_anh__a_kiem</bpmn:outgoing></bpmn:callActivity>
    <bpmn:exclusiveGateway id="g_hoi" name=""><bpmn:incoming>Flow_a_luu__g_hoi</bpmn:incoming><bpmn:incoming>Flow_b_luu__g_hoi</bpmn:incoming><bpmn:incoming>Flow_c_luu__g_hoi</bpmn:incoming><bpmn:incoming>Flow_d_luu__g_hoi</bpmn:incoming><bpmn:incoming>Flow_e_luu__g_hoi</bpmn:incoming><bpmn:outgoing>Flow_g_hoi__t_kho</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_kho" name="Đồng bộ trạng thái tồn kho: Hết hàng hoặc Đang bán"><bpmn:incoming>Flow_g_hoi__t_kho</bpmn:incoming><bpmn:outgoing>Flow_t_kho__g_nguong</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_nguong" name="Dưới ngưỡng tối thiểu?"><bpmn:incoming>Flow_t_kho__g_nguong</bpmn:incoming><bpmn:outgoing>Flow_g_nguong__t_canhbao</bpmn:outgoing><bpmn:outgoing>Flow_g_nguong__t_binhthuong</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_canhbao" name="Gửi cảnh báo Sắp hết hàng qua Dashboard và Email"><bpmn:incoming>Flow_g_nguong__t_canhbao</bpmn:incoming><bpmn:outgoing>Flow_t_canhbao__t_log</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="t_binhthuong" name="Ghi nhận trạng thái tồn kho bình thường"><bpmn:incoming>Flow_g_nguong__t_binhthuong</bpmn:incoming><bpmn:outgoing>Flow_t_binhthuong__t_log</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="t_log" name="Ghi nhật ký: người thao tác, thời gian, dữ liệu trước và sau, kết quả"><bpmn:incoming>Flow_t_canhbao__t_log</bpmn:incoming><bpmn:incoming>Flow_t_binhthuong__t_log</bpmn:incoming><bpmn:outgoing>Flow_t_log__e_end</bpmn:outgoing><bpmn:dataOutputAssociation id="DataAssoc_ds_log"><bpmn:targetRef>ds_log</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
    <bpmn:dataStoreReference id="ds_log" name="Nhật ký Sản phẩm" />
    <bpmn:endEvent id="e_end" name="Hoàn tất"><bpmn:incoming>Flow_t_log__e_end</bpmn:incoming></bpmn:endEvent>
