<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="Definitions_quan_ly_san_pham_anh_ai" name="Hình 3.12a - Xử lý ảnh sản phẩm bằng AI" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://velura.vn/bpmn/admin">
  <bpmn:collaboration id="Collaboration_quan_ly_san_pham_anh_ai">
    <bpmn:participant id="Participant_velura" name="Velura" processRef="Process_velura" />
    <bpmn:participant id="Participant_gemini" name="Google Gemini (dịch vụ AI bên ngoài)" />
    <bpmn:messageFlow id="Msg_t_gui__gemini" name="Ảnh đã thu nhỏ và yêu cầu" sourceRef="t_gui" targetRef="Participant_gemini" />
    <bpmn:messageFlow id="Msg_gemini__t_nhan" name="Ảnh nền studio" sourceRef="Participant_gemini" targetRef="t_nhan" />
  </bpmn:collaboration>
  <bpmn:process id="Process_velura" isExecutable="false">
    <bpmn:laneSet id="LaneSet_velura">
      <bpmn:lane id="lane_admin" name="Quản trị viên quản lý sản phẩm">
        <bpmn:flowNodeRef>e_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_chon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_xem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_luu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_huy</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_sys" name="Hệ thống">
        <bpmn:flowNodeRef>t_sang</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_gui</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_nhan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_studio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_studio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_banSang</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_luu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ds_anh</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="e_start" name="Cần ảnh sản phẩm"><bpmn:outgoing>Flow_e_start__t_chon</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="t_chon" name="Nhấn Xem trước nền studio, chọn ảnh JPG, PNG, WebP hoặc GIF (tối đa 5 MB)"><bpmn:incoming>Flow_e_start__t_chon</bpmn:incoming><bpmn:outgoing>Flow_t_chon__t_sang</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="t_sang" name="Thu nhỏ cạnh dài tối đa 1280 px, tăng sáng 8% và tương phản 6%"><bpmn:incoming>Flow_t_chon__t_sang</bpmn:incoming><bpmn:outgoing>Flow_t_sang__t_gui</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:sendTask id="t_gui" name="Gửi ảnh cho Gemini: giữ sản phẩm, dựng nền studio và ánh sáng mềm"><bpmn:incoming>Flow_t_sang__t_gui</bpmn:incoming><bpmn:outgoing>Flow_t_gui__t_nhan</bpmn:outgoing></bpmn:sendTask>
    <bpmn:receiveTask id="t_nhan" name="Nhận ảnh nền studio (kèm tối đa 3 câu nhận xét nếu có)"><bpmn:incoming>Flow_t_gui__t_nhan</bpmn:incoming><bpmn:outgoing>Flow_t_nhan__g_studio</bpmn:outgoing></bpmn:receiveTask>
    <bpmn:exclusiveGateway id="g_studio" name="Gemini trả về ảnh nền studio?"><bpmn:incoming>Flow_t_nhan__g_studio</bpmn:incoming><bpmn:outgoing>Flow_g_studio__t_studio</bpmn:outgoing><bpmn:outgoing>Flow_g_studio__t_banSang</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_studio" name="Đặt ảnh nền studio vào cột Sau"><bpmn:incoming>Flow_g_studio__t_studio</bpmn:incoming><bpmn:outgoing>Flow_t_studio__t_xem</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="t_banSang" name="Đặt bản ảnh đã tăng sáng vào cột Sau, ghi chú lý do chưa có nền studio"><bpmn:incoming>Flow_g_studio__t_banSang</bpmn:incoming><bpmn:outgoing>Flow_t_banSang__t_xem</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="t_xem" name="So sánh ảnh Trước và Sau, đọc ghi chú, chọn Dùng ảnh sau hoặc Giữ ảnh gốc"><bpmn:incoming>Flow_t_studio__t_xem</bpmn:incoming><bpmn:incoming>Flow_t_banSang__t_xem</bpmn:incoming><bpmn:outgoing>Flow_t_xem__g_luu</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g_luu" name="Đã chọn ảnh để lưu?"><bpmn:incoming>Flow_t_xem__g_luu</bpmn:incoming><bpmn:outgoing>Flow_g_luu__t_luu</bpmn:outgoing><bpmn:outgoing>Flow_g_luu__e_huy</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_luu" name="Tải ảnh được chọn lên kho ảnh, thêm đường dẫn vào danh sách ảnh"><bpmn:incoming>Flow_g_luu__t_luu</bpmn:incoming><bpmn:outgoing>Flow_t_luu__e_end</bpmn:outgoing><bpmn:dataOutputAssociation id="DataAssoc_ds_anh"><bpmn:targetRef>ds_anh</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
    <bpmn:endEvent id="e_end" name="Ảnh sẵn sàng gắn vào sản phẩm"><bpmn:incoming>Flow_t_luu__e_end</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="e_huy" name="Đóng, không lưu ảnh"><bpmn:incoming>Flow_g_luu__e_huy</bpmn:incoming></bpmn:endEvent>
    <bpmn:dataStoreReference id="ds_anh" name="Kho ảnh sản phẩm" />
    <bpmn:sequenceFlow id="Flow_e_start__t_chon" name="" sourceRef="e_start" targetRef="t_chon" />
    <bpmn:sequenceFlow id="Flow_t_chon__t_sang" name="" sourceRef="t_chon" targetRef="t_sang" />
    <bpmn:sequenceFlow id="Flow_t_sang__t_gui" name="" sourceRef="t_sang" targetRef="t_gui" />
    <bpmn:sequenceFlow id="Flow_t_gui__t_nhan" name="" sourceRef="t_gui" targetRef="t_nhan" />
    <bpmn:sequenceFlow id="Flow_t_nhan__g_studio" name="" sourceRef="t_nhan" targetRef="g_studio" />
    <bpmn:sequenceFlow id="Flow_g_studio__t_studio" name="Có" sourceRef="g_studio" targetRef="t_studio" />
    <bpmn:sequenceFlow id="Flow_g_studio__t_banSang" name="Không" sourceRef="g_studio" targetRef="t_banSang" />
    <bpmn:sequenceFlow id="Flow_t_studio__t_xem" name="" sourceRef="t_studio" targetRef="t_xem" />
    <bpmn:sequenceFlow id="Flow_t_banSang__t_xem" name="" sourceRef="t_banSang" targetRef="t_xem" />
    <bpmn:sequenceFlow id="Flow_t_xem__g_luu" name="" sourceRef="t_xem" targetRef="g_luu" />
    <bpmn:sequenceFlow id="Flow_g_luu__t_luu" name="Có" sourceRef="g_luu" targetRef="t_luu" />
    <bpmn:sequenceFlow id="Flow_g_luu__e_huy" name="Không" sourceRef="g_luu" targetRef="e_huy" />
    <bpmn:sequenceFlow id="Flow_t_luu__e_end" name="" sourceRef="t_luu" targetRef="e_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_quan_ly_san_pham_anh_ai">
    <bpmndi:BPMNPlane id="BPMNPlane_quan_ly_san_pham_anh_ai" bpmnElement="Collaboration_quan_ly_san_pham_anh_ai">
