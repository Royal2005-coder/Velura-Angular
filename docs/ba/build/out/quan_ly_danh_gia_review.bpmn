<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="Definitions_quan_ly_danh_gia_review" name="Hình 3.14 - Quy trình quản lý đánh giá và review" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://velura.vn/bpmn/admin">
  <bpmn:collaboration id="Collaboration_quan_ly_danh_gia_review">
    <bpmn:participant id="Participant_velura" name="Velura" processRef="Process_velura" />
    <bpmn:participant id="Participant_gemini" name="Google Gemini (dịch vụ AI bên ngoài)" />
    <bpmn:messageFlow id="Msg_r_gui__gemini" name="Nội dung, số sao và tên sản phẩm" sourceRef="r_gui" targetRef="Participant_gemini" />
    <bpmn:messageFlow id="Msg_gemini__r_nhan" name="Tối đa 2 câu gợi ý" sourceRef="Participant_gemini" targetRef="r_nhan" />
  </bpmn:collaboration>
  <bpmn:process id="Process_velura" isExecutable="false">
    <bpmn:laneSet id="LaneSet_velura">
      <bpmn:lane id="lane_admin" name="Admin">
        <bpmn:flowNodeRef>r_loc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r_xem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r_gwact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r_nhapan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r_chon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r_ticket</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_sys" name="Hệ thống">
        <bpmn:flowNodeRef>r_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r_quet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r_gwcam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r_che</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r_thuong</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r_m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r_camxuc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r_gwsao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r_duyet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r_an</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r_gui</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r_nhan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r_gwai</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r_mau</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r_hienthi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r_truyxuat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r_chuyen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r_m2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r_log</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ds_log</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r_m3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_cskh" name="Bộ phận CSKH">
        <bpmn:flowNodeRef>r_cskh</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="r_start" name="Khách gửi đánh giá mới"><bpmn:outgoing>Flow_r_start__r_quet</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="r_quet" name="Quét từ cấm (blacklist) và đọc số sao"><bpmn:incoming>Flow_r_start__r_quet</bpmn:incoming><bpmn:outgoing>Flow_r_quet__r_gwcam</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="r_gwcam" name="Chứa từ cấm?"><bpmn:incoming>Flow_r_quet__r_gwcam</bpmn:incoming><bpmn:outgoing>Flow_r_gwcam__r_che</bpmn:outgoing><bpmn:outgoing>Flow_r_gwcam__r_thuong</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="r_che" name="Che từ cấm bằng ***, ghi vào danh sách quản lý, đánh dấu khẩn"><bpmn:incoming>Flow_r_gwcam__r_che</bpmn:incoming><bpmn:outgoing>Flow_r_che__r_m1</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="r_thuong" name="Đưa vào danh sách quản lý theo thứ tự thông thường"><bpmn:incoming>Flow_r_gwcam__r_thuong</bpmn:incoming><bpmn:outgoing>Flow_r_thuong__r_m1</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="r_m1" name=""><bpmn:incoming>Flow_r_che__r_m1</bpmn:incoming><bpmn:incoming>Flow_r_thuong__r_m1</bpmn:incoming><bpmn:outgoing>Flow_r_m1__r_loc</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="r_loc" name="Dùng bộ lọc đa tiêu chí để tìm và chọn đánh giá"><bpmn:incoming>Flow_r_m1__r_loc</bpmn:incoming><bpmn:outgoing>Flow_r_loc__r_xem</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="r_xem" name="Xem chi tiết nội dung, ảnh, số sao và lịch sử mua hàng"><bpmn:incoming>Flow_r_loc__r_xem</bpmn:incoming><bpmn:outgoing>Flow_r_xem__r_camxuc</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="r_camxuc" name="Gắn nhãn cảm xúc: Tích cực, Trung tính hoặc Tiêu cực"><bpmn:incoming>Flow_r_xem__r_camxuc</bpmn:incoming><bpmn:outgoing>Flow_r_camxuc__r_gwsao</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="r_gwsao" name="Số sao ≥ 3?"><bpmn:incoming>Flow_r_camxuc__r_gwsao</bpmn:incoming><bpmn:outgoing>Flow_r_gwsao__r_gwact</bpmn:outgoing><bpmn:outgoing>Flow_r_gwsao__r_ticket</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:textAnnotation id="n_camxuc"><bpmn:text>Nhãn tính từ số sao và từ khóa tiêu cực trong nội dung (xấu, tệ, rách, lỗi, thất vọng...). Nhãn chỉ để gợi ý cho quản trị viên, không tự khóa đánh giá.</bpmn:text></bpmn:textAnnotation>
    <bpmn:exclusiveGateway id="r_gwact" name="Chọn hành động?"><bpmn:incoming>Flow_r_gwsao__r_gwact</bpmn:incoming><bpmn:outgoing>Flow_r_gwact__r_duyet</bpmn:outgoing><bpmn:outgoing>Flow_r_gwact__r_nhapan</bpmn:outgoing><bpmn:outgoing>Flow_r_gwact__r_gui</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="r_duyet" name="Phê duyệt: cho phép hiển thị công khai"><bpmn:incoming>Flow_r_gwact__r_duyet</bpmn:incoming><bpmn:outgoing>Flow_r_duyet__r_m2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="r_nhapan" name="Nhập lý do ẩn (tối thiểu 10 ký tự)"><bpmn:incoming>Flow_r_gwact__r_nhapan</bpmn:incoming><bpmn:outgoing>Flow_r_nhapan__r_an</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="r_an" name="Ẩn đánh giá khỏi trang sản phẩm, vẫn lưu trữ"><bpmn:incoming>Flow_r_nhapan__r_an</bpmn:incoming><bpmn:outgoing>Flow_r_an__r_m2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:sendTask id="r_gui" name="Gửi nội dung đánh giá cho Gemini xin gợi ý phản hồi"><bpmn:incoming>Flow_r_gwact__r_gui</bpmn:incoming><bpmn:outgoing>Flow_r_gui__r_nhan</bpmn:outgoing></bpmn:sendTask>
    <bpmn:receiveTask id="r_nhan" name="Nhận tối đa 2 câu gợi ý phản hồi"><bpmn:incoming>Flow_r_gui__r_nhan</bpmn:incoming><bpmn:outgoing>Flow_r_nhan__r_gwai</bpmn:outgoing></bpmn:receiveTask>
    <bpmn:exclusiveGateway id="r_gwai" name="Gợi ý hợp lệ?"><bpmn:incoming>Flow_r_nhan__r_gwai</bpmn:incoming><bpmn:outgoing>Flow_r_gwai__r_chon</bpmn:outgoing><bpmn:outgoing>Flow_r_gwai__r_mau</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="r_mau" name="Tạo câu mẫu bám sát nội dung đánh giá"><bpmn:incoming>Flow_r_gwai__r_mau</bpmn:incoming><bpmn:outgoing>Flow_r_mau__r_chon</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="r_chon" name="Chọn hoặc chỉnh sửa gợi ý rồi gửi phản hồi"><bpmn:incoming>Flow_r_gwai__r_chon</bpmn:incoming><bpmn:incoming>Flow_r_mau__r_chon</bpmn:incoming><bpmn:outgoing>Flow_r_chon__r_hienthi</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="r_hienthi" name="Hiển thị phản hồi công khai dưới đánh giá"><bpmn:incoming>Flow_r_chon__r_hienthi</bpmn:incoming><bpmn:outgoing>Flow_r_hienthi__r_m2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="r_ticket" name="Nhấn Tạo Ticket chăm sóc"><bpmn:incoming>Flow_r_gwsao__r_ticket</bpmn:incoming><bpmn:outgoing>Flow_r_ticket__r_truyxuat</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="r_truyxuat" name="Truy xuất dữ liệu khách: lịch sử mua, liên hệ, phiếu hỗ trợ"><bpmn:incoming>Flow_r_ticket__r_truyxuat</bpmn:incoming><bpmn:outgoing>Flow_r_truyxuat__r_chuyen</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="r_chuyen" name="Chuyển dữ liệu sang Bộ phận CSKH"><bpmn:incoming>Flow_r_truyxuat__r_chuyen</bpmn:incoming><bpmn:outgoing>Flow_r_chuyen__r_cskh</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="r_cskh" name="Liên hệ khách hàng và xử lý khiếu nại"><bpmn:incoming>Flow_r_chuyen__r_cskh</bpmn:incoming><bpmn:outgoing>Flow_r_cskh__r_m3</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="r_m2" name=""><bpmn:incoming>Flow_r_duyet__r_m2</bpmn:incoming><bpmn:incoming>Flow_r_an__r_m2</bpmn:incoming><bpmn:incoming>Flow_r_hienthi__r_m2</bpmn:incoming><bpmn:outgoing>Flow_r_m2__r_log</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="r_log" name="Ghi vết nhật ký: mã đánh giá, hành động, thời gian, người thực hiện"><bpmn:incoming>Flow_r_m2__r_log</bpmn:incoming><bpmn:outgoing>Flow_r_log__r_m3</bpmn:outgoing><bpmn:dataOutputAssociation id="DataAssoc_ds_log"><bpmn:targetRef>ds_log</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
    <bpmn:dataStoreReference id="ds_log" name="Nhật ký đánh giá" />
    <bpmn:exclusiveGateway id="r_m3" name=""><bpmn:incoming>Flow_r_log__r_m3</bpmn:incoming><bpmn:incoming>Flow_r_cskh__r_m3</bpmn:incoming><bpmn:outgoing>Flow_r_m3__r_end</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="r_end" name="Hoàn tất xử lý đánh giá"><bpmn:incoming>Flow_r_m3__r_end</bpmn:incoming><bpmn:terminateEventDefinition id="r_end_td" /></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_r_start__r_quet" name="" sourceRef="r_start" targetRef="r_quet" />
    <bpmn:sequenceFlow id="Flow_r_quet__r_gwcam" name="" sourceRef="r_quet" targetRef="r_gwcam" />
