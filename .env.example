PORT=8787
NODE_ENV=production
CORS_ORIGIN=https://velura.royalai.dev,https://admin.royalai.dev,https://admin.velura.royalai.dev,http://localhost:4001,http://localhost:4002

VELURA_SUPABASE_URL=https://gtyuajboeffmfskofoyh.supabase.co
VELURA_SUPABASE_ANON_KEY=
VELURA_SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=https://gtyuajboeffmfskofoyh.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

API_REQUEST_TIMEOUT_MS=15000
API_MAX_BODY_BYTES=15728640
ADMIN_MUTATION_LIMIT_PER_MINUTE=60

N8N_CHAT_WEBHOOK_URL=
N8N_CHAT_WEBHOOK_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM=
SUPPORT_ALERT_TO=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# eSMS: https://esms.vn — Sandbox=1 không gửi tới máy. SmsType 8 là đầu số thường.
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=
ESMS_SMS_TYPE=8
ESMS_SANDBOX=0

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STOREFRONT_ORIGIN=https://velura.royalai.dev

# SMS qua Twilio. Cần đủ 3 nhóm thì OTP mới gửi được (isTwilioConfigured):
#   1. TWILIO_ACCOUNT_SID: bắt buộc, dùng làm Account trong URL Messages.json
#   2. Khoá: TWILIO_API_KEY_SID + TWILIO_API_KEY_SECRET, hoặc TWILIO_AUTH_TOKEN đi kèm Account SID
#   3. Số gửi: TWILIO_PHONE_NUMBER (số dạng E.164 +84...) hoặc TWILIO_MESSAGING_SERVICE_SID
# Gửi tới số di động Việt Nam cần bật International SMS trong Twilio Console.
# Tài khoản trial chỉ gửi được tới số đã verify. Thiếu cấu hình thì OTP chỉ in ra console.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# SMS provider Việt Nam (eSMS). Khi SMS_PROVIDER=esms, ba biến eSMS được dùng
# thay cho Twilio; Brandname phải nằm trong danh sách đã kích hoạt của tài khoản.
SMS_PROVIDER=twilio
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=

# Stringee SMS OTP. Brandname và mẫu nội dung phải được Stringee/nhà mạng duyệt.
# Đặt SMS_PROVIDER=stringee để dùng ba biến bên dưới.
STRINGEE_API_KEY_SID=
STRINGEE_API_KEY_SECRET=
STRINGEE_BRANDNAME=

# Tác vụ System của đơn hàng: off | dry_run | on. Chạy dry_run và đối chiếu số đơn trước khi bật on.
ORDER_AUTOMATION_MODE=off

# Real hosted VNPay/MoMo integrations. Missing merchant credentials disable these options.
# VNPay merchant dashboard IPN: ${API_PUBLIC_ORIGIN}/api/user/payments/vnpay/ipn
# MoMo IPN is sent in each signed create request: /api/user/payments/momo/ipn
API_PUBLIC_ORIGIN=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_API_ORIGIN=https://test-payment.momo.vn
