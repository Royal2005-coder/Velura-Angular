{
  "version": 2,
  "buildCommand": "ng build",
  "outputDirectory": "dist/admin-ng/browser",
  "cleanUrls": true,
  "regions": ["sin1"],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://velura-api.vercel.app/api/:path*"
    },
    {
      "source": "/supabase/:path*",
      "destination": "https://gtyuajboeffmfskofoyh.supabase.co/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
