<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="Definitions_3_17_thiet_lap_chien_dich" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="http://velura.vn/bpmn/khuyenmai">
  <bpmn:collaboration id="Collaboration_3_17_thiet_lap_chien_dich">
    <bpmn:participant id="Participant_velura" name="Velura" processRef="Process_velura" />
  </bpmn:collaboration>
  <bpmn:process id="Process_velura" isExecutable="false">
    <bpmn:laneSet id="LaneSet_velura">
      <bpmn:lane id="lane_admin" name="Quản trị viên giá và khuyến mãi">
        <bpmn:flowNodeRef>ev_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_khaibao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_sys" name="Hệ thống">
        <bpmn:flowNodeRef>t_kiem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_hople</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_loi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_quydoi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ghicd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_chonglan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_chonglan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_canhbaotrung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ds_log</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ev_start" name="Có nhu cầu chạy chương trình khuyến mãi"><bpmn:outgoing>f_ev_start_t_khaibao</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="t_khaibao" name="Khai báo chiến dịch: tên, mô tả, khung thời gian, ngân sách và nội dung trình bày"><bpmn:incoming>f_ev_start_t_khaibao</bpmn:incoming><bpmn:incoming>f_t_loi_t_khaibao</bpmn:incoming><bpmn:outgoing>f_t_khaibao_t_kiem</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="t_kiem" name="Kiểm vai trò và tính hợp lệ của khung thời gian"><bpmn:incoming>f_t_khaibao_t_kiem</bpmn:incoming><bpmn:outgoing>f_t_kiem_gw_hople</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_hople" name="Dữ liệu hợp lệ?"><bpmn:incoming>f_t_kiem_gw_hople</bpmn:incoming><bpmn:outgoing>f_gw_hople_t_loi</bpmn:outgoing><bpmn:outgoing>f_gw_hople_t_quydoi</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="t_loi" name="Trả về trường sai và giữ nguyên dữ liệu đã nhập"><bpmn:incoming>f_gw_hople_t_loi</bpmn:incoming><bpmn:outgoing>f_t_loi_t_khaibao</bpmn:outgoing></bpmn:sendTask>
    <bpmn:serviceTask id="t_quydoi" name="Quy đổi ngân sách thành số mã tối đa được phát hành"><bpmn:incoming>f_gw_hople_t_quydoi</bpmn:incoming><bpmn:outgoing>f_t_quydoi_t_ghicd</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="t_ghicd" name="Ghi chiến dịch ở trạng thái Tạm dừng và ghi nhật ký"><bpmn:incoming>f_t_quydoi_t_ghicd</bpmn:incoming><bpmn:outgoing>f_t_ghicd_t_chonglan</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="t_chonglan" name="Đối chiếu chồng lấn thời gian và danh mục với chiến dịch khác"><bpmn:incoming>f_t_ghicd_t_chonglan</bpmn:incoming><bpmn:outgoing>f_t_chonglan_gw_chonglan</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_chonglan" name="Có chồng lấn?"><bpmn:incoming>f_t_chonglan_gw_chonglan</bpmn:incoming><bpmn:outgoing>f_gw_chonglan_t_canhbaotrung</bpmn:outgoing><bpmn:outgoing>f_gw_chonglan_ev_end</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="t_canhbaotrung" name="Cảnh báo trùng chiến dịch, không tự gộp mức giảm"><bpmn:incoming>f_gw_chonglan_t_canhbaotrung</bpmn:incoming><bpmn:outgoing>f_t_canhbaotrung_ev_end</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="ev_end" name="Chiến dịch chờ phát hành mã"><bpmn:incoming>f_t_canhbaotrung_ev_end</bpmn:incoming><bpmn:incoming>f_gw_chonglan_ev_end</bpmn:incoming></bpmn:endEvent>
    <bpmn:dataStoreReference id="ds_log" name="Nhật ký khuyến mãi" />
    <bpmn:textAnnotation id="n_quydoi"><bpmn:text>Số mã tối đa bằng ngân sách chiến dịch chia cho trần giảm mỗi lượt. Trần này chặn tại thời điểm phát hành mã.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="n_chonglan"><bpmn:text>Hệ thống chỉ cảnh báo. Không tự chọn giữa hai chiến dịch chồng lấn và không cộng dồn mức giảm của chúng.</bpmn:text></bpmn:textAnnotation>
    <bpmn:sequenceFlow id="f_ev_start_t_khaibao" name="" sourceRef="ev_start" targetRef="t_khaibao" />
    <bpmn:sequenceFlow id="f_t_khaibao_t_kiem" name="" sourceRef="t_khaibao" targetRef="t_kiem" />
    <bpmn:sequenceFlow id="f_t_kiem_gw_hople" name="" sourceRef="t_kiem" targetRef="gw_hople" />
    <bpmn:sequenceFlow id="f_gw_hople_t_loi" name="Không" sourceRef="gw_hople" targetRef="t_loi" />
    <bpmn:sequenceFlow id="f_t_loi_t_khaibao" name="" sourceRef="t_loi" targetRef="t_khaibao" />
    <bpmn:sequenceFlow id="f_gw_hople_t_quydoi" name="Có" sourceRef="gw_hople" targetRef="t_quydoi" />
    <bpmn:sequenceFlow id="f_t_quydoi_t_ghicd" name="" sourceRef="t_quydoi" targetRef="t_ghicd" />
    <bpmn:sequenceFlow id="f_t_ghicd_t_chonglan" name="" sourceRef="t_ghicd" targetRef="t_chonglan" />
    <bpmn:sequenceFlow id="f_t_chonglan_gw_chonglan" name="" sourceRef="t_chonglan" targetRef="gw_chonglan" />
    <bpmn:sequenceFlow id="f_gw_chonglan_t_canhbaotrung" name="Có" sourceRef="gw_chonglan" targetRef="t_canhbaotrung" />
    <bpmn:sequenceFlow id="f_t_canhbaotrung_ev_end" name="" sourceRef="t_canhbaotrung" targetRef="ev_end" />
    <bpmn:sequenceFlow id="f_gw_chonglan_ev_end" name="Không" sourceRef="gw_chonglan" targetRef="ev_end" />
    <bpmn:association id="a_t_ghicd_ds_log" sourceRef="t_ghicd" targetRef="ds_log" />
    <bpmn:association id="a_n_quydoi_t_quydoi" sourceRef="n_quydoi" targetRef="t_quydoi" />
    <bpmn:association id="a_n_chonglan_t_chonglan" sourceRef="n_chonglan" targetRef="t_chonglan" />
  </bpmn:process>
