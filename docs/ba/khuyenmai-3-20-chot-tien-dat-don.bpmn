<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="Definitions_3_20_chot_tien_dat_don" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="http://velura.vn/bpmn/khuyenmai">
  <bpmn:collaboration id="Collaboration_3_20_chot_tien_dat_don">
    <bpmn:participant id="Participant_khachhang" name="Khách hàng" processRef="Process_khachhang" />
    <bpmn:participant id="Participant_velura" name="Velura" processRef="Process_velura" />
    <bpmn:messageFlow id="m_k_dat_k_sstart" name="Giỏ hàng và mã
khách đang áp" sourceRef="k_dat" targetRef="k_sstart" />
    <bpmn:messageFlow id="m_k_taila_k_ketqua" name="Giá đã thay đổi,
vui lòng tải lại giỏ" sourceRef="k_taila" targetRef="k_ketqua" />
    <bpmn:messageFlow id="m_k_tuchoi_k_ketqua" name="Mã không còn hợp lệ" sourceRef="k_tuchoi" targetRef="k_ketqua" />
    <bpmn:messageFlow id="m_k_ghidon_k_ketqua" name="Xác nhận đơn và
số tiền đã giảm" sourceRef="k_ghidon" targetRef="k_ketqua" />
  </bpmn:collaboration>
  <bpmn:process id="Process_khachhang" isExecutable="false">
    <bpmn:laneSet id="LaneSet_khachhang">
      <bpmn:lane id="lane_kh" name="Khách hàng">
        <bpmn:flowNodeRef>k_cstart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>k_dat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>k_ketqua</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>k_cend</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="k_cstart" name="Khách bấm đặt hàng"><bpmn:outgoing>f_k_cstart_k_dat</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="k_dat" name="Xác nhận đặt hàng"><bpmn:incoming>f_k_cstart_k_dat</bpmn:incoming><bpmn:outgoing>f_k_dat_k_ketqua</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="k_ketqua" name="Nhận kết quả đặt hàng"><bpmn:incoming>f_k_dat_k_ketqua</bpmn:incoming><bpmn:outgoing>f_k_ketqua_k_cend</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="k_cend" name="Kết thúc lượt mua"><bpmn:incoming>f_k_ketqua_k_cend</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="f_k_cstart_k_dat" name="" sourceRef="k_cstart" targetRef="k_dat" />
    <bpmn:sequenceFlow id="f_k_dat_k_ketqua" name="" sourceRef="k_dat" targetRef="k_ketqua" />
    <bpmn:sequenceFlow id="f_k_ketqua_k_cend" name="" sourceRef="k_ketqua" targetRef="k_cend" />
  </bpmn:process>
  <bpmn:process id="Process_velura" isExecutable="false">
    <bpmn:laneSet id="LaneSet_velura">
      <bpmn:lane id="lane_sell" name="Hệ thống bán hàng">
        <bpmn:flowNodeRef>k_sstart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>k_gia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>k_gwgia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>k_taila</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>k_ship</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>k_endloi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>k_ghidon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>k_send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_promo" name="Dịch vụ khuyến mãi">
        <bpmn:flowNodeRef>k_chamlai</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>k_gwma</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>k_tuchoi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>k_tong</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>k_ghiluot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>k_endma</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>k_log</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="k_sstart" name="Nhận yêu cầu đặt hàng"><bpmn:outgoing>f_k_sstart_k_gia</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="k_gia" name="Tra bảng giá và tự tính tạm tính từ giá catalog"><bpmn:incoming>f_k_sstart_k_gia</bpmn:incoming><bpmn:outgoing>f_k_gia_k_gwgia</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="k_gwgia" name="Giá khớp bảng giá?"><bpmn:incoming>f_k_gia_k_gwgia</bpmn:incoming><bpmn:outgoing>f_k_gwgia_k_taila</bpmn:outgoing><bpmn:outgoing>f_k_gwgia_k_ship</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="k_taila" name="Yêu cầu tải lại giỏ hàng"><bpmn:incoming>f_k_gwgia_k_taila</bpmn:incoming><bpmn:outgoing>f_k_taila_k_endloi</bpmn:outgoing></bpmn:sendTask>
    <bpmn:serviceTask id="k_ship" name="Xác định phí vận chuyển theo ngưỡng miễn phí"><bpmn:incoming>f_k_gwgia_k_ship</bpmn:incoming><bpmn:outgoing>f_k_ship_k_chamlai</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="k_endloi" name="Dừng, chờ khách thao tác lại"><bpmn:incoming>f_k_taila_k_endloi</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="k_chamlai" name="Chấm lại mã tại thời điểm đặt đơn"><bpmn:incoming>f_k_ship_k_chamlai</bpmn:incoming><bpmn:outgoing>f_k_chamlai_k_gwma</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="k_gwma" name="Mã còn hợp lệ?"><bpmn:incoming>f_k_chamlai_k_gwma</bpmn:incoming><bpmn:outgoing>f_k_gwma_k_tuchoi</bpmn:outgoing><bpmn:outgoing>f_k_gwma_k_tong</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="k_tuchoi" name="Từ chối đơn kèm lý do cụ thể"><bpmn:incoming>f_k_gwma_k_tuchoi</bpmn:incoming><bpmn:outgoing>f_k_tuchoi_k_endma</bpmn:outgoing></bpmn:sendTask>
    <bpmn:serviceTask id="k_tong" name="Chốt tổng tiền bằng tạm tính cộng phí giao trừ giảm giá"><bpmn:incoming>f_k_gwma_k_tong</bpmn:incoming><bpmn:outgoing>f_k_tong_k_ghiluot</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="k_ghiluot" name="Ghi lượt dùng mã và cộng dồn ngân sách trong cùng giao dịch"><bpmn:incoming>f_k_tong_k_ghiluot</bpmn:incoming><bpmn:outgoing>f_k_ghiluot_k_ghidon</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="k_endma" name="Dừng, chờ khách chọn lại mã"><bpmn:incoming>f_k_tuchoi_k_endma</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="k_ghidon" name="Ghi đơn hàng kèm số tiền đã giảm"><bpmn:incoming>f_k_ghiluot_k_ghidon</bpmn:incoming><bpmn:outgoing>f_k_ghidon_k_send</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="k_send" name="Ưu đãi được ghi nhận"><bpmn:incoming>f_k_ghidon_k_send</bpmn:incoming></bpmn:endEvent>
    <bpmn:dataStoreReference id="k_log" name="Nhật ký khuyến mãi" />
    <bpmn:textAnnotation id="n_maychu"><bpmn:text>Máy chủ không nhận đơn giá, tạm tính, phí giao hay số tiền giảm do trình duyệt gửi lên. Lệch giá thì từ chối đơn.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="n_ship"><bpmn:text>Miễn phí vận chuyển là ngưỡng theo giá trị đơn do máy chủ giữ, không phải một loại mã giảm giá.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="n_huy"><bpmn:text>Huỷ đơn thì lượt dùng và phần ngân sách đã cộng được hoàn lại.</bpmn:text></bpmn:textAnnotation>
    <bpmn:sequenceFlow id="f_k_sstart_k_gia" name="" sourceRef="k_sstart" targetRef="k_gia" />
    <bpmn:sequenceFlow id="f_k_gia_k_gwgia" name="" sourceRef="k_gia" targetRef="k_gwgia" />
    <bpmn:sequenceFlow id="f_k_gwgia_k_taila" name="Không" sourceRef="k_gwgia" targetRef="k_taila" />
    <bpmn:sequenceFlow id="f_k_taila_k_endloi" name="" sourceRef="k_taila" targetRef="k_endloi" />
    <bpmn:sequenceFlow id="f_k_gwgia_k_ship" name="Có" sourceRef="k_gwgia" targetRef="k_ship" />
    <bpmn:sequenceFlow id="f_k_ship_k_chamlai" name="" sourceRef="k_ship" targetRef="k_chamlai" />
    <bpmn:sequenceFlow id="f_k_chamlai_k_gwma" name="" sourceRef="k_chamlai" targetRef="k_gwma" />
    <bpmn:sequenceFlow id="f_k_gwma_k_tuchoi" name="Không" sourceRef="k_gwma" targetRef="k_tuchoi" />
    <bpmn:sequenceFlow id="f_k_tuchoi_k_endma" name="" sourceRef="k_tuchoi" targetRef="k_endma" />
    <bpmn:sequenceFlow id="f_k_gwma_k_tong" name="Có" sourceRef="k_gwma" targetRef="k_tong" />
    <bpmn:sequenceFlow id="f_k_tong_k_ghiluot" name="" sourceRef="k_tong" targetRef="k_ghiluot" />
    <bpmn:sequenceFlow id="f_k_ghiluot_k_ghidon" name="" sourceRef="k_ghiluot" targetRef="k_ghidon" />
    <bpmn:sequenceFlow id="f_k_ghidon_k_send" name="" sourceRef="k_ghidon" targetRef="k_send" />
    <bpmn:association id="a_k_ghiluot_k_log" sourceRef="k_ghiluot" targetRef="k_log" />
    <bpmn:association id="a_n_maychu_k_gia" sourceRef="n_maychu" targetRef="k_gia" />
    <bpmn:association id="a_n_ship_k_ship" sourceRef="n_ship" targetRef="k_ship" />
    <bpmn:association id="a_n_huy_k_ghiluot" sourceRef="n_huy" targetRef="k_ghiluot" />
  </bpmn:process>
