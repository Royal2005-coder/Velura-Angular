      <bpmndi:BPMNEdge id="Flow_g_luu__t_luu_di" bpmnElement="Flow_g_luu__t_luu"><di:waypoint x="1652.5" y="155" /><di:waypoint x="1652.5" y="173" /><di:waypoint x="1621.5" y="173" /><di:waypoint x="1621.5" y="437.1" /><di:waypoint x="1719.5" y="437.1" /><bpmndi:BPMNLabel><dc:Bounds x="1629.5" y="334.665" width="26" height="20" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
