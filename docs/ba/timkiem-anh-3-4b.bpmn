<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="Definitions_3_4b" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="http://velura.vn/bpmn/timkiem-anh">
  <bpmn:collaboration id="Collaboration_3_4b">
    <bpmn:participant id="Participant_A" name="Velura - Tìm kiếm bằng hình ảnh (1/3)" processRef="Process_A" />
  </bpmn:collaboration>
  <bpmn:process id="Process_A" isExecutable="false">
    <bpmn:laneSet id="LaneSet_A">
      <bpmn:lane id="lane_u_A" name="Người dùng">
        <bpmn:flowNodeRef>a_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_cam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_pick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_crop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_s_A" name="Hệ thống">
        <bpmn:flowNodeRef>a_open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_chk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_err</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_end_err</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_prev</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="a_start" name="Người dùng muốn tìm món đồ tương tự từ một bức ảnh"><bpmn:outgoing>f_a_start_a_cam</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="a_cam" name="Nhấn biểu tượng camera trong ô tìm kiếm"><bpmn:incoming>f_a_start_a_cam</bpmn:incoming><bpmn:outgoing>f_a_cam_a_open</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="a_open" name="Mở cửa sổ chọn ảnh: tải lên, chụp ảnh, kéo thả hoặc dán"><bpmn:incoming>f_a_cam_a_open</bpmn:incoming><bpmn:outgoing>f_a_open_a_pick</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="a_pick" name="Chọn ảnh từ thiết bị hoặc chụp bằng camera"><bpmn:incoming>f_a_open_a_pick</bpmn:incoming><bpmn:outgoing>f_a_pick_a_chk</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="a_chk" name="Kiểm tra định dạng JPG, PNG, WEBP và dung lượng tối đa 5 MB"><bpmn:incoming>f_a_pick_a_chk</bpmn:incoming><bpmn:outgoing>f_a_chk_a_gw</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="a_gw" name="Ảnh hợp lệ?"><bpmn:incoming>f_a_chk_a_gw</bpmn:incoming><bpmn:outgoing>f_a_gw_a_err</bpmn:outgoing><bpmn:outgoing>f_a_gw_a_prev</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="a_err" name="Báo lỗi kèm lý do cụ thể ngay tại cửa sổ chọn ảnh"><bpmn:incoming>f_a_gw_a_err</bpmn:incoming><bpmn:outgoing>f_a_err_a_end_err</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="a_end_err" name="Người dùng ở lại cửa sổ chọn ảnh"><bpmn:incoming>f_a_err_a_end_err</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="a_prev" name="Hiển thị ảnh xem trước và khung chọn vùng (mặc định toàn ảnh)"><bpmn:incoming>f_a_gw_a_prev</bpmn:incoming><bpmn:outgoing>f_a_prev_a_crop</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="a_crop" name="Khoanh món đồ cần tìm (nếu có) rồi nhấn Tìm sản phẩm"><bpmn:incoming>f_a_prev_a_crop</bpmn:incoming><bpmn:outgoing>f_a_crop_a_end</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="a_end" name="Ảnh sẵn sàng, chuyển sang Hình 3.4c"><bpmn:incoming>f_a_crop_a_end</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="f_a_gw_a_err" name="Không" sourceRef="a_gw" targetRef="a_err" />
    <bpmn:sequenceFlow id="f_a_err_a_end_err" name="" sourceRef="a_err" targetRef="a_end_err" />
    <bpmn:sequenceFlow id="f_a_start_a_cam" name="" sourceRef="a_start" targetRef="a_cam" />
    <bpmn:sequenceFlow id="f_a_cam_a_open" name="" sourceRef="a_cam" targetRef="a_open" />
    <bpmn:sequenceFlow id="f_a_open_a_pick" name="" sourceRef="a_open" targetRef="a_pick" />
    <bpmn:sequenceFlow id="f_a_pick_a_chk" name="" sourceRef="a_pick" targetRef="a_chk" />
    <bpmn:sequenceFlow id="f_a_chk_a_gw" name="" sourceRef="a_chk" targetRef="a_gw" />
    <bpmn:sequenceFlow id="f_a_gw_a_prev" name="Có" sourceRef="a_gw" targetRef="a_prev" />
    <bpmn:sequenceFlow id="f_a_prev_a_crop" name="" sourceRef="a_prev" targetRef="a_crop" />
    <bpmn:sequenceFlow id="f_a_crop_a_end" name="" sourceRef="a_crop" targetRef="a_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_3_4b">
    <bpmndi:BPMNPlane id="BPMNPlane_3_4b" bpmnElement="Collaboration_3_4b">
      <bpmndi:BPMNShape id="Participant_A_di" bpmnElement="Participant_A" isHorizontal="true"><dc:Bounds x="40" y="40" width="2245" height="686" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_u_A_di" bpmnElement="lane_u_A" isHorizontal="true"><dc:Bounds x="70" y="40" width="2215" height="196" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_s_A_di" bpmnElement="lane_s_A" isHorizontal="true"><dc:Bounds x="70" y="236" width="2215" height="490" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_start_di" bpmnElement="a_start"><dc:Bounds x="172" y="120" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_cam_di" bpmnElement="a_cam"><dc:Bounds x="330" y="96" width="190" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_open_di" bpmnElement="a_open"><dc:Bounds x="565" y="271" width="190" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_pick_di" bpmnElement="a_pick"><dc:Bounds x="800" y="96" width="190" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_chk_di" bpmnElement="a_chk"><dc:Bounds x="1035" y="271" width="190" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_gw_di" bpmnElement="a_gw" isMarkerVisible="true"><dc:Bounds x="1342" y="290" width="46" height="46" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_err_di" bpmnElement="a_err"><dc:Bounds x="1270" y="439" width="190" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_end_err_di" bpmnElement="a_end_err"><dc:Bounds x="1347" y="631" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_prev_di" bpmnElement="a_prev"><dc:Bounds x="1505" y="271" width="190" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_crop_di" bpmnElement="a_crop"><dc:Bounds x="1740" y="96" width="190" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_end_di" bpmnElement="a_end"><dc:Bounds x="2052" y="120" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f_a_gw_a_err_di" bpmnElement="f_a_gw_a_err"><di:waypoint x="1342" y="313" /><di:waypoint x="1460" y="313" /><di:waypoint x="1460" y="481" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_a_err_a_end_err_di" bpmnElement="f_a_err_a_end_err"><di:waypoint x="1460" y="481" /><di:waypoint x="1347" y="481" /><di:waypoint x="1347" y="649" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_a_start_a_cam_di" bpmnElement="f_a_start_a_cam"><di:waypoint x="208" y="138" /><di:waypoint x="330" y="138" /><di:waypoint x="330" y="138" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_a_cam_a_open_di" bpmnElement="f_a_cam_a_open"><di:waypoint x="520" y="138" /><di:waypoint x="565" y="138" /><di:waypoint x="565" y="313" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_a_open_a_pick_di" bpmnElement="f_a_open_a_pick"><di:waypoint x="755" y="313" /><di:waypoint x="800" y="313" /><di:waypoint x="800" y="138" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_a_pick_a_chk_di" bpmnElement="f_a_pick_a_chk"><di:waypoint x="990" y="138" /><di:waypoint x="1035" y="138" /><di:waypoint x="1035" y="313" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_a_chk_a_gw_di" bpmnElement="f_a_chk_a_gw"><di:waypoint x="1225" y="313" /><di:waypoint x="1342" y="313" /><di:waypoint x="1342" y="313" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_a_gw_a_prev_di" bpmnElement="f_a_gw_a_prev"><di:waypoint x="1388" y="313" /><di:waypoint x="1505" y="313" /><di:waypoint x="1505" y="313" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_a_prev_a_crop_di" bpmnElement="f_a_prev_a_crop"><di:waypoint x="1695" y="313" /><di:waypoint x="1740" y="313" /><di:waypoint x="1740" y="138" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_a_crop_a_end_di" bpmnElement="f_a_crop_a_end"><di:waypoint x="1930" y="138" /><di:waypoint x="2052" y="138" /><di:waypoint x="2052" y="138" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>