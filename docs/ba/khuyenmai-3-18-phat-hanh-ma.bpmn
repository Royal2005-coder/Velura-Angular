      <bpmndi:BPMNShape id="v_log_di" bpmnElement="v_log"><dc:Bounds x="1008" y="898.2" width="150" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_rpc_di" bpmnElement="n_rpc"><dc:Bounds x="623.5" y="888.2" width="26" height="104" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_nhom_di" bpmnElement="n_nhom"><dc:Bounds x="1540" y="888.2" width="26" height="104" /></bpmndi:BPMNShape>
